# Copy to .env and fill in. Only EXPO_PUBLIC_* values reach the app — never put secrets here.
# The mobile app uses the anon key only; RLS enforces per-patient access. No service-role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Base URL of the deployed apps/web backend (audio/document extraction + ask). For the pushed
# app this must be the deployed URL; localhost only works when the web dev server is running.
EXPO_PUBLIC_API_URL=
