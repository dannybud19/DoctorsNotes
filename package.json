{
  "name": "doctorsnotes",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --filter \"./packages/*\" run typecheck",
    "typecheck:all": "pnpm -r run typecheck",
    "test": "pnpm -r --filter \"./packages/*\" run test",
    "depcruise": "depcruise --config .dependency-cruiser.cjs packages apps",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run depcruise"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "dependency-cruiser": "^16.4.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "pnpm": {
    "overrides": {
      "react": "18.3.1",
      "react-dom": "18.3.1"
    }
  }
}
